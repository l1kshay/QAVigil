# QAVigil - local environment template.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In CI these same keys come from GitHub Actions Secrets, not from a file.

# --- target application under test ---
BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com/api

# --- browser behaviour ---
# BROWSER: chromium | firefox | webkit
BROWSER=chromium
HEADLESS=true
# Per-action/navigation timeout in milliseconds.
TIMEOUT_MS=30000
# Slows each Playwright action by this many ms. 0 in CI; raise it to watch a run.
SLOW_MO_MS=0

# --- test account credentials ---
# A pre-existing account on the target site, used by login tests that need a
# known-good user. Tests needing a fresh/unique account create one via Faker.
TEST_USER_EMAIL=you@example.com
TEST_USER_PASSWORD=change-me
